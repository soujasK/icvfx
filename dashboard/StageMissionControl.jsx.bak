                    title="Download the calibrated remediated snapshot PNG"
                  >
                    <span>DOWNLOAD PNG</span>
                  </a>
                </div>
              </div>
            )
          )}

          {/* Before vs After State */}
          <div style={styles.stateShiftBox}>
