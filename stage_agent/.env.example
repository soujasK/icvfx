# Copy to stage_agent/.env and fill in. ADK auto-loads this file.

# --- Gemini via Vertex AI (Google Cloud) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Model for the Stage Incident Commander
STAGE_AGENT_MODEL=gemini-2.5-pro

# Auth: run `gcloud auth application-default login` (uses ADC), OR point at a
# service-account key:
# GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/sa-key.json
